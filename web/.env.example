# Cấu hình Firebase giống dự án Sổ Chủ Nhiệm Thông Minh.
# Có thể để trống: ứng dụng vẫn chạy chế độ demo cục bộ qua localStorage/BroadcastChannel.
# Tùy chọn trên Vercel; nếu bỏ trống hệ thống tự dùng VERCEL_PROJECT_PRODUCTION_URL.
NEXT_PUBLIC_SITE_URL=

# Khi chạy tách: `npm run dev` (cổng 3000) + `python run_hub.py` (cổng 8765).
# Mặc định http://127.0.0.1:8765. Đổi nếu hub ở máy/cổng khác.
# NEXT_PUBLIC_HUB_URL=http://127.0.0.1:8765
# EXAMGUARD_HUB_URL=http://127.0.0.1:8765

NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
