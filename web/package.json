{
  "name": "ai-examguard",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "dev:https": "next dev --hostname 0.0.0.0 --experimental-https --experimental-https-key ./certs/dev-key.pem --experimental-https-cert ./certs/dev-cert.pem",

    "build": "next build",
    "start": "next start",
    "lint": "eslint . --ignore-pattern .next",
    "test": "node --test tests/unit/*.test.cjs"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "firebase": "^12.18.0",
    "lucide-react": "1.31.0",
    "next": "^16.3.2",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module"
